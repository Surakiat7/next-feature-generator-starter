# Show a floating shortcut to the Starter Dashboard (/dashboard-demo) from the
# application. Useful while initially configuring the project. Disable it once
# your application setup is complete.
#
# Disabling this only hides the floating shortcut. It does NOT disable the
# generators (pnpm gen ...) and does NOT block /dashboard-demo, which remains
# reachable via direct navigation.
#
# Safe default: if this variable is missing, the shortcut is hidden.
SHOW_STARTER_DASHBOARD=true
